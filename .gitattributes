# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Explicit LF for Godot-authored text types — never let Windows CRLF conversion turn a
# one-number change into a several-hundred-line .tscn/.tres diff. Do not rely on text=auto
# heuristics for these.
*.gd     text eol=lf
*.tres   text eol=lf
*.tscn   text eol=lf
*.import text eol=lf
*.uid    text eol=lf
*.godot  text eol=lf
*.cfg    text eol=lf

# Binary asset types (story 3-0a) — the rig assets are committed directly to git (no LFS).
# Mark them binary so Git never attempts EOL normalization or line-diffing on them.
*.fbx    binary
*.png    binary
# Story 7-1 (effect presentation): the processed effect assets -- the skull mesh, the rock textures and
# the trimmed sound clips. `.ogg` is listed with them so a later re-encode cannot slip in as text.
*.glb    binary
*.jpg    binary
*.wav    binary
*.ogg    binary

[node name="AnimationController" type="Node3D" parent="."]
script = ExtResource("16_anctl")
animation_player_path = NodePath("../Mesh/Paladin/AnimationPlayer")
editor_description = "Rig presentation layer (story 3-0a): READ-ONLY per-hero consumer of the action-state seam (connect_hero_action_state_changed), wired by the runner at match start like TelegraphController. Selects one of the paladin's six skinned clips: IDLE/ATTACKING/BLOCKING/ROLLING/DEAD from the seam, `run` PUSHED from HeroActor.drive()'s per-tick velocity magnitude while IDLE (gate ruling 3-0a/R2). Never a state handle, never a mutator. NO _physics_process (F1)."

[node name="Hurtbox" type="Area3D" parent="."]
collision_layer = 2
collision_mask = 0
monitoring = false
editor_description = "Hurtbox (story 1-7). LAYER/MASK CONVENTION: layer 2 'hurtbox' (bit value 2), mask 0 - it is DETECTED by hitboxes and detects nothing (monitoring off). NO gameplay logic and it NEVER applies damage; it exists purely to be reported as an overlap fact. Mirrors the body collision box."


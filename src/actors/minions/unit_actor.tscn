[gd_scene format=3]

[ext_resource type="Script" path="res://src/actors/minions/unit_actor.gd" id="1_unitactor"]
[ext_resource type="PackedScene" path="res://assets/characters/skeletonzombie/skeletonzombie.fbx" id="2_szmodel"]

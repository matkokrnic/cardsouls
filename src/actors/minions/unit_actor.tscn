[gd_scene format=3]

[ext_resource type="Script" path="res://src/actors/minions/unit_actor.gd" id="1_unitactor"]

[sub_resource type="BoxMesh" id="BoxMesh_unitbox"]
size = Vector3(0.6, 1.2, 0.6)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_unitgrey"]
albedo_color = Color(0.55, 0.55, 0.58, 1)

[sub_resource type="BoxShape3D" id="BoxShape3D_unitbody"]
size = Vector3(0.6, 1.2, 0.6)

[sub_resource type="BoxShape3D" id="BoxShape3D_unithitbx"]
size = Vector3(1, 1.2, 1.4)

[node name="UnitActor" type="CharacterBody3D"]

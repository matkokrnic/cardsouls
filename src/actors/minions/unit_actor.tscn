[ext_resource type="Script" path="res://src/actors/minions/unit_animation_controller.gd" id="4_szanctl"]

[sub_resource type="BoxShape3D" id="BoxShape3D_unitbody"]
size = Vector3(0.6, 1.2, 0.6)

[sub_resource type="BoxShape3D" id="BoxShape3D_unithitbx"]
size = Vector3(1, 1.2, 1.4)

[node name="UnitActor" type="CharacterBody3D"]
script = ExtResource("1_unitactor")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 0)
shape = SubResource("BoxShape3D_unitbody")
editor_description = "Story 4-3 (AC 4, ruling 4-3/R17). The unit's BODY shape, sized to the existing grey box (0.6 x 1.2 x 0.6) and offset +0.6 in y for the same reason the Mesh is: the unit ROOT is at the box's FEET (the runner spawns units at y 0), unlike the hero root which is its body CENTRE. NO layer/mask lines, exactly like hero.tscn's HeroActor root - both bodies sit on default layer 1 'bodies', which is what makes a unit block a hero without a new layer and without touching project.godot (measured: test_unit_approach_live.gd). Unit-vs-unit blocking falls out of the same default layer but is NOT measured by this story (4-3/R21; filed deferred-work.md, owner 4-3a). This is the WHOLE BODY-collision mechanism, and nothing more. DEV PASS CORRECTION (story 4-3b): this description used to end 'there is deliberately NO hurtbox and NO Area3D on this scene - a unit takes no damage until 4-3a ships one', which stopped being true the moment 4-3a shipped the Hurtbox node directly below (whose own description already records that it discharged that promise), and is doubly false since 4-3b added the Hitbox. This scene now carries TWO Area3Ds - a Hurtbox it is DETECTED by and a Hitbox it DETECTS with - and neither of them is this node's business."

[node name="Hurtbox" type="Area3D" parent="."]
collision_layer = 2
collision_mask = 0
monitoring = false
editor_description = "Unit hurtbox (story 4-3a, AC 4, ruling 4-3a/R11). LAYER/MASK CONVENTION, the hero.tscn Hurtbox verbatim: layer 2 'hurtbox' (bit value 2), mask 0, monitoring off - it is DETECTED by hitboxes and detects nothing. THE EXISTING layer 2 is reused rather than a new layer authored, and that is what keeps project.godot and hero.tscn BYTE-IDENTICAL through this story: the hero Hitbox already declares collision_mask = 2, so this box is visible to it with no edit on either side, and nothing other than that hitbox masks layer 2. This node discharges the promise the Collision node's own description made - 'there is deliberately NO hurtbox and NO Area3D on this scene - a unit takes no damage until 4-3a ships one'. NO gameplay logic here and it NEVER applies damage: the runner's _gather_contact_facts resolves this area's owning actor to a [slot, index] target address, filters same-slot overlaps (no friendly fire, AC 6), and pushes the fact through MatchState.push_contact; advance() step 4 decides (actors REPORT, state DECIDES)."

[node name="HurtboxShape" type="CollisionShape3D" parent="Hurtbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 0)
shape = SubResource("BoxShape3D_unitbody")
editor_description = "Mirrors the BODY collision box exactly - same shape sub-resource, same +0.6 y offset for the same reason (the unit ROOT is at the box's FEET, unlike the hero root which is its body CENTRE). Sharing the sub-resource rather than duplicating its size literal is deliberate: 'the hurtbox mirrors the body collision box' is then true by construction instead of by two numbers agreeing."

[node name="Hitbox" type="Area3D" parent="."]
collision_layer = 4
collision_mask = 2
monitorable = false
editor_description = "Unit hitbox (story 4-3b, AC 2). LAYER/MASK CONVENTION, the hero.tscn Hitbox verbatim: layer 3 'hitbox' (bit value 4), mask = layer 2 'hurtbox' (bit value 2), monitorable off - it DETECTS hurtboxes and is detected by nothing, so hitboxes never see hitboxes. THE EXISTING layer 3 is reused rather than a new layer authored, which is what keeps project.godot and hero.tscn BYTE-IDENTICAL through this story, exactly as 4-3a's Hurtbox reused the existing layer 2 (4-3a/R11): the hero Hurtbox and this scene's own Hurtbox already declare collision_layer = 2, so both are visible to this box with no edit on either side. NO gameplay logic here and it NEVER applies damage: the runner's _gather_unit_contact_facts queries get_overlapping_areas() ONLY while state flags this unit's ACTIVE window open (UnitBoard.is_hitbox_active_at), identity-filters self-overlaps, filters same-slot overlaps at GATHER time (no friendly fire, AC 6), and pushes facts through MatchState.push_contact; advance() step 4 decides (actors REPORT, state DECIDES). Aimed by yawing the whole ROOT from the state-owned LOCKED attack direction (AC 12) - safe on this scene, unlike the hero's, because this root carries no camera rig (DECISION A applies to hero.tscn only)."

[node name="HitboxShape" type="CollisionShape3D" parent="Hitbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, -0.9)
shape = SubResource("BoxShape3D_unithitbx")
editor_description = "Offset FORWARD along local -Z, which is this scene's forward: UnitActor.aim_at/aim_along yaw with atan2(x, z) + PI, Godot's -Z-forward convention (a Node3D looks down its own -Z). The hero's HitboxShape sits at +z 0.9 because the hero MESH carries the opposite yaw convention - same reach, mirrored axis, and getting this sign wrong ships a minion that swings backwards. Also offset +0.6 in y like every other shape on this scene, because the unit ROOT is at the box's FEET. Sized to reach a target standing at the authored unit_stop_distance: the box spans 0.2 to 1.6 forward of the unit centre, and a hero halted at 1.5 presents its hurtbox face at 1.0."

[node name="SkeletonZombie" parent="." instance=ExtResource("2_szmodel")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
editor_description = "Story 4-3c (AC 2, ruling 4-3c/R3). The skinned Mixamo skeleton-zombie, REPLACING the grey placeholder box, and parented DIRECTLY UNDER THE ROOT with no TRANSLATION of its own - yaw only - not under the old `Mesh` node, which is DELETED along with its BoxMesh geometry. THE OFFSET IS THE WHOLE POINT: `Mesh` carried +0.6 in y, exactly like Collision/HurtboxShape/HitboxShape, because the unit ROOT sits at the body box's FEET (the runner spawns units at world y 0). This model's own origin ALSO sits at its feet, so parenting it under a +0.6 node would add that offset a second time and hover the minion 0.6 above the ground - the mirror image of the hero's own pre-3-0b floating defect (hero.tscn's root is the body CENTRE, so ITS Mesh node needed a COMPENSATING -1.0). Deleting `Mesh` outright rather than keeping it as an emptied pass-through parent is the recordable micro-decision AC 2 leaves to the dev pass: nothing in src/ or test/ references this scene's `Mesh` node (measured, zero hits), and an emptied MeshInstance3D whose transform must be zeroed anyway would be a misleadingly-typed node kept for nothing. Imported at native Mixamo scale (root_scale = 1.0, no manual correction); the minion's final on-screen SIZE is explicitly not decided by this story (Non-Goals - one decision about three numbers, owner Matko, taken at the Live Smoke). Pinned by test/integration/test_unit_vertical_alignment.gd. POST-SMOKE CORRECTION (4-3c fix pass): the model carries a compensating PI yaw (exact (-1,0,0,0,1,0,0,0,-1) basis, zero origin) because it mounts backwards otherwise - see the Dev Agent Record for the full hero/unit yaw-convention analysis."

[node name="AnimationPlayer" type="AnimationPlayer" parent="SkeletonZombie"]
root_node = NodePath("..")
libraries = {
&"": ExtResource("3_szanims")
}
editor_description = "Story 4-3c (AC 3). The minion's FOUR clips - idle, walk, attack, death - as one AnimationLibrary, the paladin's six-clip AnimationPlayer in miniature. `root_node = NodePath(\"..\")` points at the model instance above so the library's imported track paths (`Skeleton3D:mixamorig_Hips`, ...) resolve against THIS skeleton, exactly as hero.tscn's own AnimationPlayer resolves the paladin's. The model's bundled Mixamo take (`mixamo_com`) is NOT here and cannot be: it is stripped at import time by assets/characters/skeletonzombie/strip_model_anim.gd, on 3-0a/R10's sanctioned EditorScenePostImport route - the importer's own `animation/import=false` does NOT strip it on this engine build (4.6.3), a finding 3-0a already measured and this story carries forward rather than re-discovering. The library itself is built headlessly and reproducibly by tools/build_zombie_anims.gd. Pinned by test/integration/test_unit_rig_clips.gd."

[node name="AnimationController" type="Node" parent="."]
script = ExtResource("4_szanctl")
animation_player_path = NodePath("../SkeletonZombie/AnimationPlayer")
editor_description = "Rig presentation layer (story 4-3c, AC 4): READ-ONLY per-unit clip selector, the hero's AnimationController counterpart. PUSHED, never evented and never polled on its own clock: the minion has no action-state signal (4-3b's attack rhythm is a plain scalar per board index and units carry no per-record signal), so MatchRunner._aim_unit_actors - which already touches every spawned live unit actor once per physics frame and already reads attack_phase_at there - carries the payload on its existing call. No new seam, no new loop, NO _physics_process (F1), no state handle, no mutator. Selection is liveness-BEFORE-phase (a unit killed mid-swing keeps its frozen attack_phase forever, so only liveness tells the controller the swing is over), and the runner PUSHES BEFORE it checks liveness (operator ruling 4-3c/R15) so a corpse is always told it died - the ordering 4-3d's lingering corpse depends on."

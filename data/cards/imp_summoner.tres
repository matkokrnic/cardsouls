[gd_resource type="Resource" script_class="CardData" load_steps=7 format=3]

[ext_resource type="Script" path="res://src/state/resources/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://src/state/resources/card_effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://src/state/resources/card_cast_condition.gd" id="3_cast"]

[sub_resource type="Resource" id="Resource_basic"]
script = ExtResource("2_effect")
effect_id = &"summon_imp"

[sub_resource type="Resource" id="Resource_cast"]
script = ExtResource("3_cast")
mana_cost = 3.0

[sub_resource type="Resource" id="Resource_pitch"]
script = ExtResource("3_cast")
mana_cost = 3.0
orb_costs = Dictionary[int, int]({
0: 1
})

[resource]
script = ExtResource("1_card")
id = &"imp_summoner"
color = 0
basic_effect = SubResource("Resource_basic")
cast_condition = SubResource("Resource_cast")
pitch_condition = SubResource("Resource_pitch")
max_copies = 3
